{
  "schemaVersion": 3,
  "description": "Publication ledger for local holiday photography. Only items with status approved and complete provenance, commercial-use permission, cultural-context review, accessibility text, and local derivatives may render.",
  "requiredReviewFields": [
    "id",
    "status",
    "holidaySlugs",
    "title",
    "originalFile",
    "sourceUrl",
    "creator",
    "licenseName",
    "licenseUrl",
    "commercialUseAllowed",
    "attributionText",
    "culturalContextReviewer",
    "altText",
    "reviewedBy",
    "reviewedAt"
  ],
  "imageRules": {
    "storeLocally": true,
    "preferredFormats": [
      "avif",
      "webp"
    ],
    "fallbackFormat": "jpg",
    "responsiveWidths": [
      480,
      768,
      1200,
      1600
    ],
    "maxHeroBytes": 350000,
    "maxCardBytes": 140000,
    "stripLocationMetadata": true,
    "doNotUseUnverifiedRemoteImages": true,
    "heroMaxBytes": 350000,
    "cardMaxBytes": 140000,
    "requireAltText": true,
    "requireVisibleAttribution": true
  },
  "items": []
}
